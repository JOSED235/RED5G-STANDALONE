# =====================================================================
# Configuración única del laboratorio 5G Standalone (fuente de verdad)
# ---------------------------------------------------------------------
# Copie este archivo como .env (manage_lab.ps1 y make lo hacen solos si no existe).
# .env NO se versiona: en la Fase 3 aquí irán las credenciales de la SIM física.
# Docker Compose lee .env y pasa los valores a los contenedores, que generan sus
# archivos de configuración a partir de plantillas (docker/comun/renderizar_plantilla.sh).
# Tras cambiar un valor: .\manage_lab.ps1 restart (o make restart).
# =====================================================================

# --- Versiones fijadas (reproducibilidad) ----------------------------
# Núcleo y WebUI se compilan desde la misma etiqueta del código fuente de Open5GS.
OPEN5GS_VERSION=v2.8.0

# --- Identidad de la red (PLMN de pruebas 001/01, nunca el MCC comercial 732) ---
MCC=001
MNC=01
TAC=7
SST=1
DNN=internet

# --- Seguridad NAS del AMF (orden de preferencia) ---------------------
# Integridad: NIA2 (AES-CMAC) primero; NIA0 (sin integridad) solo como respaldo.
# Cifrado: NEA2 (AES-CTR) primero. Requiere el srsUE 26.10 (srsRAN_4G 06f0b1e23): el
# anterior (bef8680d5) no descifraba los mensajes NAS con NEA1/2/3 y no completaba el
# registro (falla F2-15, corregida aguas arriba en 2144cb589; verificado el 2026-11-02
# con la traza: Security Mode Command con NEA2 + NIA2 y sesión PDU establecida).
# Si se usa un srsUE anterior, poner NEA0 primero: NEA0, NEA2, NEA1.
AMF_INTEGRITY_ORDER=NIA2, NIA1, NIA0
AMF_CIPHERING_ORDER=NEA2, NEA1, NEA0

# --- Seguridad AS del gNB (RRC/PDCP en la interfaz radio) ------------
# Independiente de la NAS. srsRAN Project prefiere nea0 por defecto (radio sin cifrar);
# aquí se prioriza nea2 (AES). Formato de srsRAN: minúsculas separadas por comas.
GNB_NEA_PREF_LIST=nea2,nea1,nea3,nea0
GNB_NIA_PREF_LIST=nia2,nia1,nia3

# --- Suscriptor de prueba (USIM emulada del srsUE, valores públicos de prueba) ---
UE_IMSI=001010123456780
UE_K=00112233445566778899aabbccddeeff
UE_OPC=63BFA50EE6523365FF14C1F45F88737D
UE_IMEI=353490069873319

# --- Direccionamiento de la red Docker (red5g_net) --------------------
# 10.53.0.0/24 queda fuera de los rangos que Docker asigna solo a las redes de otros
# proyectos (172.17-172.31 y 192.168.x), del rango aleatorio de WSL2 (172.16.0.0/12) y de
# la subred de los UE (10.45.0.0/16). Antes era 172.20.0.0/24 y chocaba con otros proyectos
# Compose ("Pool overlaps"). Si aun así choca: python -m banco verificar sugiere otra.
SUBRED_DOCKER=10.53.0.0/24
MONGO_IP=10.53.0.2
OPEN5GS_IP=10.53.0.3
GNB_IP=10.53.0.4
UE_IP=10.53.0.5
WEBUI_IP=10.53.0.6
# gNB con SDR de la Fase 3 (perfil 'sdr'): IP propia para poder convivir con el gNB ZMQ.
GNB_SDR_IP=10.53.0.7
# La subred de los UE (10.45.0.0/16, pasarela 10.45.0.1 en ogstun) es la de los
# yaml por defecto de SMF y UPF de Open5GS y no se parametriza.

# --- Rango de MCS del scheduler del gNB (prueba P8) -------------------
# 0..28 = adaptación de enlace libre. Para fijar el MCS se iguala mínimo y máximo;
# el banco de pruebas (python -m banco p8) los sobrescribe sin editar este archivo.
PDSCH_MIN_MCS=0
PDSCH_MAX_MCS=28
PUSCH_MIN_MCS=0
PUSCH_MAX_MCS=28

# --- Etiqueta del equipo donde se mide (queda en los metadatos de cada prueba) ---
# Las cifras dependen de la CPU (ver README, "Sobre el rendimiento").
EQUIPO=

# --- Fase 3: gNB con SDR (servicio gnb-sdr, perfil 'sdr') -------------
# Solo se usan con 'manage_lab.ps1 up-sdr' / 'make up-sdr'. Plantillas en docker/gnb/:
#   gnb_b210_n3.yaml  (n3 FDD, 20 MHz, SCS 15 kHz: misma celda que la Fase 2)
#   gnb_b210_n78.yaml (n78 TDD, 20 MHz, SCS 30 kHz: la banda SA de la mayoría de teléfonos)
# SEGURIDAD: pruebas conducidas por cable con atenuadores (60-80 dB) hasta tener permiso de
# MinTIC; calcule antes la potencia con 'python -m banco enlace'.
GNB_CONFIG=gnb_b210_n3.yaml
SDR_DEVICE_ARGS=type=b200,num_recv_frames=64,num_send_frames=64
# default | internal | external | gpsdo (external/gpsdo con referencia de 10 MHz y PPS)
SDR_CLOCK=default
SDR_SYNC=default
# Ganancias en dB del AD9361 (TX 0-89,8; RX 0-76). Empiece bajo y suba con el enlace a la vista.
SDR_TX_GAIN=50
SDR_RX_GAIN=40
# Identificador físico de la celda (0-1007)
PCI=1

# --- Fase 3: SIM física programable (sysmoISIM u otra) ---------------
# Valores con los que se programó la SIM (IMSI 00101..., K y OPc de 32 hex). Se dan de alta
# con 'python -m banco suscriptor'. SON SECRETOS (Ley 1581 de 2012): solo en este .env local,
# nunca en git, capturas ni informes; el banco los oculta en metadata.json.
SIM_IMSI=
SIM_K=
SIM_OPC=

